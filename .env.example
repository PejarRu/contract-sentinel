# =============================================================================
# contract-sentinel — environment template
#
# This file is a TEMPLATE ONLY. It contains no real values.
# Real values live on the server: /opt/contract-sentinel/secrets/sentinel.env
# Copy this template there and fill it in:
#   cp .env.example /opt/contract-sentinel/secrets/sentinel.env
#
# NAMES BELOW ARE VERIFIED AGAINST CODE:
#   - scanner: src/scanner/index.ts (ETHERSCAN_API_KEY, SCAN_INTERVAL_MIN)
#   - db: src/lib/db.ts (DATABASE_PATH, CONTRACTS_DIR, REPORTS_DIR)
#   - orchestrator: src/orchestrator.ts (EMAIL_ENABLED, SMTP_*, FROM, TO)
#   - sync-sheet: src/lib/sheets.ts (GOOGLE_OAUTH_*, SHEET_ID)
# Variables the code does not read have been removed.
# =============================================================================

# --- Etherscan API (SCANNER, RESOLVER) -------------------------------------
ETHERSCAN_API_KEY=
# Chain ID for discovery (mainnet by default)
CHAIN_ID=1

# --- Paths (container-side; host equivalents under /opt/contract-sentinel) ---
# SQLite database
DATABASE_PATH=data/contract-sentinel.sqlite
# Directory to save verified source files
CONTRACTS_DIR=contracts
# Directory for JSON/HTML reports
REPORTS_DIR=reports

# --- Scanner behaviour -----------------------------------------------------
SCAN_INTERVAL_MIN=15
# If set to 1, use mock data instead of live Etherscan (for tests/smoke)
MOCK_MODE=

# --- Email / reporting -----------------------------------------------------
# Master switch: email is sent ONLY when EMAIL_ENABLED=true.
EMAIL_ENABLED=false
# Recipient
EMAIL_TO=
# Sender address; empty => falls back to EMAIL_TO.
EMAIL_FROM=
# SMTP host
SMTP_HOST=
SMTP_PORT=587
# SMTP credentials (LIVES ONLY on server, never in git)
SMTP_USER=
SMTP_PASSWORD=

# --- Google Sheet tracker (sync-sheet) (LIVES ONLY on server, never in git) -
# OAuth client (type: web app, redirect http://localhost:8765)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Long-lived refresh token (one-time consent flow, see docs/SESSION_HANDOFF.md)
GOOGLE_REFRESH_TOKEN=
# Spreadsheet id from the Google Sheet URL
SHEET_ID=
